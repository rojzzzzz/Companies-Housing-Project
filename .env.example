# Companies House API key
API_KEY=

# PostgreSQL warehouse (localhost for running Python outside Docker)
POSTGRES_DB=housing
POSTGRES_USER=housing
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# dbt CLI outside Docker: use the same value as POSTGRES_PASSWORD.
# Docker Compose supplies this automatically.
DBT_ENV_SECRET_PASSWORD=

# Metabase application database
METABASE_DB_PASSWORD=

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Optional persistent output; leave empty for console only.
LOG_FILE=

# On Linux/WSL, set this to the output of id -u.
AIRFLOW_UID=1000
